<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_quick_pay_receipt" model="ir.actions.report">
        <field name="name">Student Fee Invoice</field>
        <field name="model">quick.pay</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quick_pay.report_quick_pay_receipt_document</field>
        <field name="report_file">quick_pay.report_quick_pay_receipt_document</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_quick_pay"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_quick_pay_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page qp-inv">
                        <style>
                            .qp-inv {
                                font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1a1a2e;
                                width: 100%; max-width: 190mm; margin: 0 auto; box-sizing: border-box;
                            }
                            .qp-inv table { border-collapse: collapse; width: 100%; }
                            .qp-inv .qp-inv-header {
                                display: flex; align-items: center; justify-content: space-between;
                                border-bottom: 3px solid #1e2a6e; padding-bottom: 10px; margin-bottom: 4px;
                            }
                            .qp-inv .qp-inv-header-left { display: flex; align-items: center; gap: 10px; }
                            .qp-inv .qp-inv-header-left img { max-height: 46px; }
                            .qp-inv .qp-inv-company-name { font-size: 20px; font-weight: 800; color: #1e2a6e; margin: 0; letter-spacing: 0.5px; }
                            .qp-inv .qp-inv-title { font-size: 26px; font-weight: 800; color: #1e2a6e; letter-spacing: 1px; text-align: right; }
                            .qp-inv .qp-inv-meta-table td { border: 1px solid #1e2a6e; padding: 6px 8px; vertical-align: top; }
                            .qp-inv .qp-inv-meta-label { font-weight: 700; font-size: 11px; }
                            .qp-inv table.qp-inv-items th {
                                background: #1e2a6e; color: #ffffff; padding: 7px 8px;
                                font-size: 11px; text-align: left;
                            }
                            .qp-inv table.qp-inv-items td {
                                border-left: 1px solid #1e2a6e; border-right: 1px solid #1e2a6e;
                                border-bottom: 1px solid #1e2a6e; padding: 8px; font-size: 12px;
                            }
                            .qp-inv table.qp-inv-items { border: 1px solid #1e2a6e; }
                            .qp-inv .qp-inv-total-row td { font-weight: 800; font-size: 13px; border-top: 2px solid #1e2a6e; }
                            .qp-inv .qp-inv-words {
                                border: 1px solid #1e2a6e; border-top: none; padding: 6px 8px; font-size: 12px;
                            }
                            .qp-inv .qp-inv-gstin {
                                text-align: center; font-weight: 700; padding: 8px 0;
                                border: 1px solid #1e2a6e; border-top: none; letter-spacing: 0.5px;
                            }
                            .qp-inv .qp-inv-declare-table td {
                                border: 1px solid #1e2a6e; border-top: none; padding: 8px; font-size: 10px; vertical-align: top; width: 50%;
                            }
                            .qp-inv .qp-inv-declare-table strong { font-size: 11px; }
                            .qp-inv .qp-inv-declare-table ol { margin: 4px 0 0; padding-left: 16px; }
                            .qp-inv .qp-inv-sign-table td {
                                border-left: 1px solid #1e2a6e; border-right: 1px solid #1e2a6e;
                                border-bottom: 1px solid #1e2a6e; padding: 30px 8px 8px; font-size: 11px; width: 50%;
                            }
                            .qp-inv .qp-inv-jurisdiction {
                                text-align: center; font-weight: 800; font-size: 12px;
                                margin-top: 8px; letter-spacing: 0.5px;
                            }
                        </style>

                        <!-- Header -->
                        <div class="qp-inv-header">
                            <div class="qp-inv-header-left">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"/>
                                <div>
                                    <p class="qp-inv-company-name"><t t-esc="o.company_id.name"/></p>
                                </div>
                            </div>
                            <div class="qp-inv-title">STUDENT FEE INVOICE</div>
                        </div>

                        <!-- Company / Student details -->
                        <table class="qp-inv-meta-table mb-0">
                            <tr>
                                <td style="width:55%;">
                                    <div class="qp-inv-meta-label"><t t-esc="o.company_id.name"/></div>
                                    <div>
                                        <t t-esc="o.company_id.partner_id.street or ''"/><t t-if="o.company_id.partner_id.street2">, <t t-esc="o.company_id.partner_id.street2"/></t><br/>
                                        <t t-if="o.company_id.partner_id.city"><t t-esc="o.company_id.partner_id.city"/></t><t t-if="o.company_id.partner_id.state_id">, <t t-esc="o.company_id.partner_id.state_id.name"/></t><t t-if="o.company_id.partner_id.zip"> - <t t-esc="o.company_id.partner_id.zip"/></t>
                                    </div>
                                    <div t-if="o.company_id.phone">Mobile: <t t-esc="o.company_id.phone"/></div>
                                    <div t-if="o.company_id.website">Web: <t t-esc="o.company_id.website"/></div>
                                </td>
                                <td style="width:45%;">
                                    <div class="qp-inv-meta-label">Student Details:</div>
                                    <div><t t-esc="o.student_name"/></div>
                                    <div t-if="o.place"><t t-esc="o.place"/></div>
                                    <div>Ph: <t t-esc="o.phone"/></div>
                                </td>
                            </tr>
                        </table>
                        <table class="qp-inv-meta-table mb-0" style="border-top:none;">
                            <tr>
                                <td style="width:27.5%;">
                                    <span class="qp-inv-meta-label">Invoice No: </span><t t-esc="o.name"/>
                                </td>
                                <td style="width:27.5%;">
                                    <span class="qp-inv-meta-label">Dated: </span>
                                    <t t-esc="o.submission_date.strftime('%d/%m/%Y') if o.submission_date else ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="qp-inv-meta-label">Reference No &amp; Date: </span>
                                    <t t-esc="o.name"/> &amp; <t t-esc="o.submission_date.strftime('%d/%m/%Y') if o.submission_date else ''"/>
                                </td>
                                <td>
                                    <span class="qp-inv-meta-label">Mode/Terms of Payment: </span>ONLINE
                                </td>
                            </tr>
                        </table>

                        <!-- Particulars -->
                        <table class="qp-inv-items mt-2">
                            <thead>
                                <tr>
                                    <th style="width:8%;">Sl.No</th>
                                    <th>Particulars</th>
                                    <th style="width:14%;text-align:right;">CGST (Rs.)</th>
                                    <th style="width:14%;text-align:right;">SGST (Rs.)</th>
                                    <th style="width:16%;text-align:right;">Fee (Rs.)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>01</td>
                                    <td><t t-esc="o.batch_id.name"/> - <span t-esc="o.fee_type"/></td>
                                    <td style="text-align:right;">
                                        <span t-esc="'{:,.2f}'.format(o.gst_amount / 2)"/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-esc="'{:,.2f}'.format(o.gst_amount / 2)"/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-esc="'{:,.2f}'.format(o.fee_amount)"/>
                                    </td>
                                </tr>
                                <tr t-if="o.enrollment_id and o.enrollment_id.due_amount &gt; 0">
                                    <td colspan="5" style="font-size:11px;color:#b45309;">
                                        Balance remaining on this enrollment: Rs. <span t-esc="'{:,.2f}'.format(o.enrollment_id.due_amount)"/>
                                        of a total course fee of Rs. <span t-esc="'{:,.2f}'.format(o.enrollment_id.total_fee)"/>
                                    </td>
                                </tr>
                                <tr class="qp-inv-total-row">
                                    <td colspan="4" style="text-align:right;">Total</td>
                                    <td style="text-align:right;"><span t-esc="'{:,.2f}'.format(o.fee_amount)"/>/-</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="qp-inv-words">
                            <strong>Total Fee (in words):</strong>
                            <span t-esc="o.company_id.currency_id.amount_to_text(o.fee_amount)"/>
                        </div>
                        <div class="qp-inv-gstin" t-if="o.company_id.vat">
                            GSTIN : <t t-esc="o.company_id.vat"/>
                        </div>

                        <!-- Declaration / Terms -->
                        <table class="qp-inv-declare-table mb-0">
                            <tr>
                                <td>
                                    <strong>Declaration</strong>
                                    <div>We declare that this invoice shows the actual price of
                                        the services described and that all particulars are
                                        true and correct.</div>
                                </td>
                                <td>
                                    <strong>Terms &amp; Conditions</strong>
                                    <ol>
                                        <li>Fees once paid are non-refundable unless specified
                                            by the institute policy.</li>
                                        <li>Students must retain this invoice for future
                                            reference.</li>
                                    </ol>
                                </td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <table class="qp-inv-sign-table mb-0">
                            <tr>
                                <td>Authorised Signature</td>
                                <td>Receiver's Signature</td>
                            </tr>
                        </table>

                        <div class="qp-inv-jurisdiction" t-if="o.company_id.partner_id.city">
                            SUBJECT TO <t t-esc="o.company_id.partner_id.city.upper()"/> JURISDICTION
                        </div>

                        <p t-if="o.verified_by" class="text-muted mt-2" style="font-size:10px;">
                            Verified by <span t-field="o.verified_by.name"/> on <span t-field="o.verified_date"/>.
                            This is a computer-generated document.
                        </p>
                    </div>
                </t>
            </t>
    </template>
</odoo>
