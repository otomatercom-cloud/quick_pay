<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_quick_pay" model="ir.module.category">
        <field name="name">Quick Pay</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_quick_pay" model="res.groups.privilege">
        <field name="name">Quick Pay</field>
        <field name="category_id" ref="module_category_quick_pay"/>
    </record>

    <record id="group_quick_pay_user" model="res.groups">
        <field name="name">Quick Pay User</field>
        <field name="privilege_id" ref="privilege_quick_pay"/>
        <field name="comment">Can view Quick Pay requests (read-only).</field>
    </record>

    <record id="group_quick_pay_accounts" model="res.groups">
        <field name="name">Quick Pay Accounts</field>
        <field name="privilege_id" ref="privilege_quick_pay"/>
        <field name="implied_ids" eval="[(4, ref('group_quick_pay_user'))]"/>
        <field name="comment">Can verify or reject payment requests.</field>
    </record>

    <record id="group_quick_pay_manager" model="res.groups">
        <field name="name">Quick Pay Manager</field>
        <field name="privilege_id" ref="privilege_quick_pay"/>
        <field name="implied_ids" eval="[(4, ref('group_quick_pay_accounts'))]"/>
        <field name="comment">Full access, including cancelling requests.</field>
    </record>

    <!-- Only Accounts/Manager can see the Verify/Reject buttons and menu -->
    <record id="quick_pay_rule_accounts_all" model="ir.rule">
        <field name="name">Quick Pay: Accounts/Manager see all</field>
        <field name="model_id" ref="model_quick_pay"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_quick_pay_user'))]"/>
    </record>
</odoo>
