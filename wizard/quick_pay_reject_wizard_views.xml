<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_quick_pay_reject_wizard_form" model="ir.ui.view">
        <field name="name">quick.pay.reject.wizard.form</field>
        <field name="model">quick.pay.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Payment Request">
                <sheet>
                    <field name="quick_pay_id" invisible="1"/>
                    <group>
                        <field name="reason" placeholder="Why is this payment request being rejected?"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
